rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== TROQUE pelo UID do dono da barbearia (Firebase Console > Authentication > Users) ======
    function isAdmin() {
    return request.auth != null && request.auth.uid == 'COLE_AQUI_O_UID_DO_ADMIN';
    }

    // ====== Mantenha igual ao config.js: ids dos barbeiros e formas de pagamento ======
    function barbeiros() { return ['rafa', 'dudu', 'marcio']; }
    function formas()    { return ['Pix', 'Dinheiro', 'Cartão de débito', 'Cartão de crédito']; }

    // Campos que toda reserva pública precisa ter (valida tipo, formato e valores).
    // hora no formato HH:00 ou HH:30; duracao em MINUTOS.
    function baseOk(d) {
      return d.dataISO is string && d.dataISO.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
          && d.hora is string && d.hora.matches('^[0-2][0-9]:[03]0$')
          && d.profissional in barbeiros()
          && d.diaProf == d.dataISO + '#' + d.profissional
          && d.duracao is int && d.duracao >= 5 && d.duracao <= 720
          && d.bloqueado == false
          && d.createdAt == request.time;
    }
    // O id do documento é sempre ag_DATA_HORA_barbeiro: impede duas reservas no mesmo início
    function idOk(id, d) {
      return id == 'ag_' + d.dataISO + '_' + d.hora + '_' + d.profissional;
    }

    // ---------- OCUPAÇÃO: pública, sem dados pessoais (só dia, hora, barbeiro e duração) ----------
    match /ocupacao/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.auth != null
        && request.resource.data.keys().hasOnly(
             ['dataISO','hora','diaProf','profissional','duracao','bloqueado','createdAt'])
        && baseOk(request.resource.data)
        && idOk(id, request.resource.data)
      );
      allow update, delete: if isAdmin();   // cliente nunca altera nem apaga
    }

    // ---------- AGENDAMENTOS: dados do cliente. Só o dono lê/edita/apaga ----------
    match /agendamentos/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.auth != null
        && request.resource.data.keys().hasOnly(
             ['dataISO','hora','profissional','diaProf','barbeiroNome','clienteNome','clienteTel',
              'servico','servicos','valor','duracao','horaFim','bloqueado','pagamentoPref','status','createdAt'])
        && baseOk(request.resource.data)
        && idOk(id, request.resource.data)
        && request.resource.data.clienteNome is string
        && request.resource.data.clienteNome.size() >= 2
        && request.resource.data.clienteNome.size() <= 80
        && request.resource.data.clienteTel is string
        && request.resource.data.clienteTel.size() <= 20
        && request.resource.data.servico is string
        && request.resource.data.servico.size() <= 300
        && request.resource.data.servicos is list
        && request.resource.data.servicos.size() >= 1
        && request.resource.data.servicos.size() <= 20
        && request.resource.data.valor is number
        && request.resource.data.valor >= 0 && request.resource.data.valor <= 5000
        && request.resource.data.pagamentoPref in formas()
        && request.resource.data.status == 'agendado'
      );
    }

    // ---------- Clientes: somente painel (o painel cria a partir dos agendamentos) ----------
    match /clientes/{id} { allow read, write: if isAdmin(); }

    // ---------- Configuração (ex.: bloquear horários seguintes): todos leem, só o painel altera ----------
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Qualquer outra coleção: negado
    match /{document=**} { allow read, write: if false; }
  }
}
